IDENTIFICATION DIVISION.
PROGRAM-ID. Q21-TRANSACTION-FILE.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TRANS-FILE ASSIGN TO "TRANSACT.DAT"
        ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS WS-FILE-STATUS.
DATA DIVISION.
FILE SECTION.
FD TRANS-FILE.
01 TRANS-RECORD PIC X(40).
WORKING-STORAGE SECTION.
01 WS-FILE-STATUS PIC XX.
01 WS-EOF PIC X VALUE 'N'.
01 WS-TRANS-ID PIC X(10).
01 WS-TYPE PIC X.
01 WS-AMOUNT-TEXT PIC X(10).
01 WS-AMOUNT PIC S9(9).
01 WS-VALID-COUNT PIC 9(7) VALUE 0.
01 WS-REJECT-COUNT PIC 9(7) VALUE 0.
01 WS-TOTAL PIC 9(12) VALUE 0.
PROCEDURE DIVISION.
    OPEN INPUT TRANS-FILE
    IF WS-FILE-STATUS NOT = "00"
        DISPLAY "FILE OPEN ERROR: " WS-FILE-STATUS
        STOP RUN
    END-IF
    PERFORM UNTIL WS-EOF = 'Y'
        READ TRANS-FILE
            AT END MOVE 'Y' TO WS-EOF
            NOT AT END
                MOVE SPACES TO WS-TRANS-ID WS-TYPE WS-AMOUNT-TEXT
                UNSTRING TRANS-RECORD DELIMITED BY ALL SPACE
                    INTO WS-TRANS-ID WS-TYPE WS-AMOUNT-TEXT
                END-UNSTRING
                IF (WS-TYPE = 'D' OR WS-TYPE = 'W') AND FUNCTION TEST-NUMVAL(WS-AMOUNT-TEXT) = 0
                    COMPUTE WS-AMOUNT = FUNCTION NUMVAL(WS-AMOUNT-TEXT)
                    IF WS-AMOUNT >= 0
                        ADD 1 TO WS-VALID-COUNT
                        ADD WS-AMOUNT TO WS-TOTAL
                    ELSE
                        ADD 1 TO WS-REJECT-COUNT
                    END-IF
                ELSE
                    ADD 1 TO WS-REJECT-COUNT
                END-IF
        END-READ
    END-PERFORM
    CLOSE TRANS-FILE
    DISPLAY "Valid records: " WS-VALID-COUNT
    DISPLAY "Rejected records: " WS-REJECT-COUNT
    DISPLAY "Valid amount total: " WS-TOTAL
    STOP RUN.
